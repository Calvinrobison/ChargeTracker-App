{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "./out/types/node",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@domain/*": ["src/domain/*"],
      "@database/*": ["src/database/*"],
      "@collector/*": ["src/collector/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/collector/**/*.ts",
    "src/database/**/*.ts",
    "src/domain/**/*.ts",
    "src/shared/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/nodeps/**/*.ts",
    "tests/fixtures/**/*.ts",
    // format.ts is renderer code, but tests/nodeps/format.test.ts imports it:
    // it is a pure module with no DOM, and the honesty rules it enforces are
    // worth testing without a browser.
    "src/renderer/src/format.ts",
    // Imported with a JSON import attribute by src/main/index.ts.
    "resources/update-keys/keys.json",
    "scripts/**/*.mts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
