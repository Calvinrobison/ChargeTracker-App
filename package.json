{
  "name": "chargewatch",
  "productName": "ChargeWatch",
  "version": "0.3.0",
  "description": "Local historical observation tool for public EV charger status around Mesa, Arizona.",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Calvin Robison"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "make:icons": "node scripts/make-icons.mjs",
    "check:icons": "node scripts/make-icons.mjs --check",
    "setup:browser": "node scripts/setup-browser.mjs",
    "setup:browser:verify": "node scripts/setup-browser.mjs --verify",
    "dev": "electron-vite dev",
    "generate:migrations": "node scripts/generate-migrations.mjs",
    "check:migrations": "node scripts/generate-migrations.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:nodeps": "node scripts/test-nodeps.mjs",
    "build:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-all.ps1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run check:migrations && npm run check:icons && npm run test:nodeps && npm run format && npm run lint && npm run typecheck",
    "build": "npm run check:migrations && electron-vite build && node scripts/build-workers.mjs",
    "package:win": "npm run build && npm run check:icons && npm run setup:browser:verify && electron-builder --win --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "test:installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/test-installed.ps1",
    "test:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/test-update.ps1",
    "db:probe": "node scripts/windows/db-probe.mjs",
    "catalog:refresh": "node scripts/catalog-refresh.mjs",
    "keys:bootstrap": "node scripts/keys-bootstrap.mjs",
    "keys:show": "node scripts/keys-bootstrap.mjs --show",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:verify": "node --experimental-strip-types --no-warnings scripts/release-verify.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "//scripts-not-yet-implemented": "test:installed and test:update require Windows and a packaged build; they fail with a stated reason rather than passing vacuously elsewhere. npm run test:nodeps runs 507 real specs with no install required; npm test runs the same 507 under Vitest; npm run test:e2e runs 42 UI specs against the built renderer and needs npm run build first. Nothing here has been packaged or installed on Windows — see docs/VERIFICATION_REPORT.md.",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "leaflet": "^1.9.4",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
